{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexus:contracts:v1:telemetry",
  "title": "NeXus Telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "hardware_model_id",
    "sample_id",
    "recorded_at",
    "sequence",
    "measurements",
    "quality"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "device_id": { "type": "string", "pattern": "^nexus-[a-z0-9-]+$" },
    "hardware_model_id": { "type": "string", "pattern": "^nexus-[a-z0-9-]+$" },
    "sample_id": { "type": "string", "minLength": 1 },
    "recorded_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "sequence": { "type": "integer", "minimum": 0 },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bus_voltage_v",
        "current_ma",
        "power_mw",
        "pwm_percent",
        "driver_enabled",
        "motor_rpm"
      ],
      "properties": {
        "bus_voltage_v": { "type": "number", "minimum": 0 },
        "current_ma": { "type": "number" },
        "power_mw": { "type": "number" },
        "pwm_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "driver_enabled": { "type": "boolean" },
        "motor_rpm": {
          "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }]
        },
        "total_current_ma": { "oneOf": [{ "type": "number" }, { "type": "null" }] },
        "rpm_left": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
        "rpm_right": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
        "rpm_rear": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
        "rpm_delta": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
        "pwm_left_percent": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
        "pwm_right_percent": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
        "pwm_rear_percent": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 100 }, { "type": "null" }] },
        "pid_state": { "oneOf": [{ "type": "string", "maxLength": 64 }, { "type": "null" }] },
        "ps2_connected": { "type": ["boolean", "null"] },
        "ps2_failsafe_active": { "type": ["boolean", "null"] },
        "ps2_last_packet_age_ms": { "type": ["integer", "null"], "minimum": 0 },
        "control_mode": {
          "oneOf": [
            { "type": "string", "enum": ["ps2_manual", "failsafe"] },
            { "type": "null" }
          ]
        },
        "drive_armed": { "type": ["boolean", "null"] },
        "bno055_connected": { "type": ["boolean", "null"] },
        "imu_heading_deg": { "type": ["number", "null"] },
        "imu_roll_deg": { "type": ["number", "null"] },
        "imu_pitch_deg": { "type": ["number", "null"] },
        "imu_accel_x_mps2": { "type": ["number", "null"] },
        "imu_accel_y_mps2": { "type": ["number", "null"] },
        "imu_accel_z_mps2": { "type": ["number", "null"] }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_quality_percent", "source"],
      "properties": {
        "signal_quality_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "source": { "type": "string", "enum": ["device", "simulator", "replay"] }
      }
    }
  }
}
