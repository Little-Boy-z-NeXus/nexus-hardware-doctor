      "from_pin": "out2",
      "to_component_id": "dc_motor",
      "to_pin": "motor_minus",
      "signal_type": "ground"
    }
  ],
  "safety_limits": {
    "max_pwm_percent": 80,
    "min_bus_voltage_v": 9.5,
