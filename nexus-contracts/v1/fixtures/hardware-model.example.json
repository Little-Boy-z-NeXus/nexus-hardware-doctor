{
  "schema_version": "1.0.0",
  "hardware_model_id": "nexus-s3-l298n-motor-rig-v1",
  "device_id": "nexus-demo-esp32",
  "name": "NeXus GOOUUU ESP32-S3-N16R8 L298N motor demo rig",
  "components": [
    {
      "component_id": "esp32",
      "component_type": "controller",
      "model": "GOOUUU Tech ESP32-S3-WROOM-1-N16R8",
      "pins": [
        { "pin_id": "gpio_1", "label": "SDA", "mode": "i2c" },
        { "pin_id": "gpio_2", "label": "SCL", "mode": "i2c" },
        { "pin_id": "gpio_12", "label": "ENA", "mode": "pwm" },
        { "pin_id": "gpio_13", "label": "IN1", "mode": "output" },
        { "pin_id": "gpio_14", "label": "IN2", "mode": "output" },
        { "pin_id": "gpio_16", "label": "Encoder A", "mode": "input" },
        { "pin_id": "gpio_17", "label": "Encoder B", "mode": "input" }
      ],
      "capabilities": ["sample_telemetry", "control_motor"]
    },
    {
      "component_id": "ina219",
      "component_type": "sensor",
      "model": "INA219",
      "pins": [
        { "pin_id": "sda", "label": "SDA", "mode": "i2c" },
        { "pin_id": "scl", "label": "SCL", "mode": "i2c" }
      ],
      "capabilities": ["measure_voltage", "measure_current"]
    },
    {
      "component_id": "l298n",
      "component_type": "driver",
      "model": "L298N",
      "pins": [
        { "pin_id": "ena", "label": "ENA", "mode": "pwm" },
        { "pin_id": "in1", "label": "IN1", "mode": "input" },
        { "pin_id": "in2", "label": "IN2", "mode": "input" },
        { "pin_id": "out1", "label": "OUT1", "mode": "output" },
        { "pin_id": "out2", "label": "OUT2", "mode": "output" }
      ],
      "capabilities": ["enable_driver", "set_pwm"]
    },
    {
      "component_id": "dc_motor",
      "component_type": "actuator",
      "model": "JGB37-520 12V brushed DC gearmotor with Hall encoder",
      "pins": [
        { "pin_id": "motor_plus", "label": "+", "mode": "power" },
        { "pin_id": "motor_minus", "label": "-", "mode": "ground" },
        { "pin_id": "encoder_a", "label": "Encoder A", "mode": "output" },
        { "pin_id": "encoder_b", "label": "Encoder B", "mode": "output" }
      ],
      "capabilities": ["rotate", "measure_rpm"]
    }
  ],
  "connections": [
    {
      "connection_id": "esp32_to_ina219_sda",
      "from_component_id": "esp32",
      "from_pin": "gpio_1",
      "to_component_id": "ina219",
      "to_pin": "sda",
      "signal_type": "i2c"
    },
    {
      "connection_id": "esp32_to_ina219_scl",
      "from_component_id": "esp32",
      "from_pin": "gpio_2",
      "to_component_id": "ina219",
      "to_pin": "scl",
      "signal_type": "i2c"
    },
    {
      "connection_id": "esp32_to_l298n_pwm",
      "from_component_id": "esp32",
      "from_pin": "gpio_12",
      "to_component_id": "l298n",
      "to_pin": "ena",
      "signal_type": "pwm"
    },
    {
      "connection_id": "esp32_to_l298n_in1",
      "from_component_id": "esp32",
      "from_pin": "gpio_13",
      "to_component_id": "l298n",
      "to_pin": "in1",
      "signal_type": "digital"
    },
    {
      "connection_id": "esp32_to_l298n_in2",
      "from_component_id": "esp32",
      "from_pin": "gpio_14",
      "to_component_id": "l298n",
      "to_pin": "in2",
      "signal_type": "digital"
    },
    {
      "connection_id": "l298n_to_motor_positive",
      "from_component_id": "l298n",
      "from_pin": "out1",
      "to_component_id": "dc_motor",
      "to_pin": "motor_plus",
      "signal_type": "power"
    },
    {
      "connection_id": "l298n_to_motor_negative",
      "from_component_id": "l298n",
      "from_pin": "out2",
      "to_component_id": "dc_motor",
      "to_pin": "motor_minus",
      "signal_type": "ground"
    },
    {
      "connection_id": "motor_encoder_a_to_esp32",
      "from_component_id": "dc_motor",
      "from_pin": "encoder_a",
      "to_component_id": "esp32",
      "to_pin": "gpio_16",
      "signal_type": "digital"
    },
    {
      "connection_id": "motor_encoder_b_to_esp32",
      "from_component_id": "dc_motor",
      "from_pin": "encoder_b",
      "to_component_id": "esp32",
      "to_pin": "gpio_17",
      "signal_type": "digital"
    }
  ],
  "safety_limits": {
    "max_pwm_percent": 80,
    "min_bus_voltage_v": 9.5,
    "max_current_ma": 1500,
    "max_motor_test_duration_ms": 3000
  },
  "updated_at": "2026-09-09T10:00:00Z"
}
