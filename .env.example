# Backend
NEXUS_ENV=development
NEXUS_DB_PATH=artifacts/nexus.sqlite3
NEXUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NEXUS_NEBIUS_BASE_URL=
NEXUS_NEBIUS_API_KEY=
NEXUS_NVIDIA_MODEL=
# Optional Nemotron template control and bounded reasoning + answer token budget.
NEXUS_NEBIUS_ENABLE_THINKING=
NEXUS_NEBIUS_MAX_OUTPUT_TOKENS=2048
NEXUS_ENABLE_LIVE_MODEL=false

# Device transport
NEXUS_MQTT_URL=mqtt://localhost:1883
NEXUS_DEVICE_ID=nexus-demo-esp32
NEXUS_SERIAL_ENABLED=true
# Leave blank for automatic GOOUUU ESP32-S3 detection (VID:PID 303A:1001).
NEXUS_SERIAL_PORT=
# Optional: bind serial reads/history to an already registered source=device ID.
# Blank preserves the standalone live monitor; it never enables motor writes.
NEXUS_SERIAL_DEVICE_ID=
NEXUS_LOG_ENABLED=true
# Relative paths are resolved from the repository root.
NEXUS_LOG_DIR=logs

# Safety policy
NEXUS_MAX_PWM_PERCENT=80
