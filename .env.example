# Backend
# Windows: double-click nexus-configure-nebius.cmd; do not paste the API key here.
NEXUS_ENV=development
NEXUS_DB_PATH=artifacts/nexus.sqlite3
NEXUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NEXUS_NEBIUS_BASE_URL=
NEXUS_NEBIUS_API_KEY=
NEXUS_NVIDIA_MODEL=
# Optional Nemotron template control and bounded reasoning + answer token budget.
NEXUS_NEBIUS_ENABLE_THINKING=
NEXUS_NEBIUS_MAX_OUTPUT_TOKENS=2048
NEXUS_ENABLE_LIVE_MODEL=false

# Device transport
NEXUS_MQTT_URL=mqtt://localhost:1883
# Optional absolute/relative JSON profile path. Blank selects the certified ESP32 MVP profile.
NEXUS_HARDWARE_PROFILE_PATH=
NEXUS_SERIAL_ENABLED=true
# Leave blank to use USB discovery identities from the selected hardware profile.
NEXUS_SERIAL_PORT=
# Optional strict binding. Blank discovers device_id from profile-verified firmware telemetry,
# auto-registers the selected hardware profile and never enables motor writes.
NEXUS_SERIAL_DEVICE_ID=
NEXUS_LOG_ENABLED=true
# Relative paths are resolved from the repository root.
NEXUS_LOG_DIR=logs

# Safety policy
