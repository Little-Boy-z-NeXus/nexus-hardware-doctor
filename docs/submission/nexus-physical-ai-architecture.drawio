        <mxCell id="hardware" value="&lt;font style=&quot;font-size:17px;color:#0284C7;&quot;&gt;&lt;b&gt;01 · PHYSICAL LAYER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:28px;&quot;&gt;&lt;b&gt;HARDWARE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;GOOUUU ESP32-S3&lt;/b&gt;&lt;br&gt;INA226 · R100&lt;br&gt;L298N driver&lt;br&gt;JGB37-520 motor&lt;br&gt;Hall A/B encoder&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Real voltage, current&lt;br&gt;and physical motion&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=24;fillColor=#EAF6FF;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#0EA5E9;strokeWidth=3;fontSize=20;fontColor=#0F2A4A;fontFamily=Arial;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="220" width="260" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="telemetry" value="&lt;font style=&quot;font-size:17px;color:#0F9D8A;&quot;&gt;&lt;b&gt;02 · DEVICE EVIDENCE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:28px;&quot;&gt;&lt;b&gt;TELEMETRY&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;bus_voltage_v&lt;/b&gt;&lt;br&gt;&lt;b&gt;current_ma&lt;/b&gt;&lt;br&gt;&lt;b&gt;pwm_percent&lt;/b&gt;&lt;br&gt;&lt;b&gt;motor_rpm&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Versioned JSON&lt;br&gt;source=device&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=24;fillColor=#E8FBF7;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#14B8A6;strokeWidth=3;fontSize=20;fontColor=#0F2A4A;fontFamily=Arial;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="220" width="250" height="430" as="geometry"/>
