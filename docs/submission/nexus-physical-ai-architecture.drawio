        <mxCell id="title" value="&lt;b&gt;NeXus · PHYSICAL AI ARCHITECTURE&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=46;fontColor=#0F2A4A;fontFamily=Arial;" vertex="1" parent="1">
