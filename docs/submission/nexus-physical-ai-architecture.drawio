        <mxCell id="safety" value="&lt;font style=&quot;font-size:17px;color:#B45309;&quot;&gt;&lt;b&gt;05 · CONTROL BOUNDARY&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:27px;&quot;&gt;&lt;b&gt;SAFETY POLICY&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;DEFAULT DENY&lt;/b&gt;&lt;br&gt;Voltage/current limits&lt;br&gt;PWM + duration limits&lt;br&gt;Allowlisted tools only&lt;br&gt;Human + physical interlock&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;Approve or reject&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=24;fillColor=#FFF7E6;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#F59E0B;strokeWidth=4;fontSize=20;fontColor=#0F2A4A;fontFamily=Arial;shadow=1;" vertex="1" parent="1">
