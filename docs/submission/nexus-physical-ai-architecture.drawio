        <mxCell id="backend" value="&lt;font style=&quot;font-size:17px;color:#2563EB;&quot;&gt;&lt;b&gt;03 · TRUSTED RUNTIME&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:28px;&quot;&gt;&lt;b&gt;BACKEND&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Schema v1 validation&lt;br&gt;Serial bridge · COM13&lt;br&gt;WebSocket + REST API&lt;br&gt;Persistent NDJSON log&lt;br&gt;Hardware graph&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Validate · Stream · Store&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=24;fillColor=#EEF5FF;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#3B82F6;strokeWidth=3;fontSize=20;fontColor=#0F2A4A;fontFamily=Arial;shadow=1;" vertex="1" parent="1">
