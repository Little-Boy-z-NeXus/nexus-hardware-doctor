        <mxCell id="subtitle" value="Hardware → Telemetry → Backend → NVIDIA Nemotron on Nebius → Safety Policy → Verify" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=23;fontColor=#486581;fontFamily=Arial;" vertex="1" parent="1">
