        </mxCell>
        <mxCell id="nemotron" value="&lt;font style=&quot;font-size:17px;color:#6D28D9;&quot;&gt;&lt;b&gt;04 · AI REASONING&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:27px;&quot;&gt;&lt;b&gt;NVIDIA NEMOTRON&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:22px;color:#7C3AED;&quot;&gt;&lt;b&gt;ON NEBIUS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;Grounded hardware context&lt;br&gt;Ranked hypotheses&lt;br&gt;Evidence IDs&lt;br&gt;Read-only tool proposal&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;AI proposes — never writes&lt;br&gt;directly to hardware&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=24;fillColor=#F4EEFF;gradientColor=#FFFFFF;gradientDirection=south;strokeColor=#8B5CF6;strokeWidth=3;fontSize=20;fontColor=#0F2A4A;fontFamily=Arial;shadow=1;" vertex="1" parent="1">
