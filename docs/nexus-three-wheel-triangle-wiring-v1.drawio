        <mxCell id="legend" value="&lt;b&gt;MÀU DÂY&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#dc2626&quot;&gt;━━ +12V / M+&lt;/font&gt;　&lt;font color=&quot;#111827&quot;&gt;━━ GND&lt;/font&gt;　&lt;font color=&quot;#7c3aed&quot;&gt;━━ 3.3V&lt;/font&gt;　&lt;font color=&quot;#06b6d4&quot;&gt;━━ I²C SDA&lt;/font&gt;　&lt;font color=&quot;#2563eb&quot;&gt;━━ I²C SCL&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#f97316&quot;&gt;━━ PWM / DIR&lt;/font&gt;　&lt;font color=&quot;#eab308&quot;&gt;━━ Encoder A&lt;/font&gt;　&lt;font color=&quot;#16a34a&quot;&gt;━━ Encoder B&lt;/font&gt;　&lt;font color=&quot;#64748b&quot;&gt;━━ M− / trắng&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b42318&quot;&gt;&lt;b&gt;AN TOÀN: ngắt pin trước khi đấu dây; không chạy dòng motor qua breadboard; kiểm tra đúng cực tụ và GND chung.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Ba encoder: ĐỎ=M+ · ĐEN=GND encoder · VÀNG=A · XANH LÁ=B · XANH DƯƠNG=VCC 3.3V · TRẮNG=M−.&lt;br&gt;2 × L298N chỉ dùng 3 kênh: #1A=M1, #1B=M2, #2A=M3; #2B luôn disabled. BNO055 đặt gần tâm tam giác." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;fontColor=#102a43;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="520" y="1810" width="2570" height="200" as="geometry"/></mxCell>
