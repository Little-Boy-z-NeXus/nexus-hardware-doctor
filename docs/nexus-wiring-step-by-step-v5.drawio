<mxfile host="app.diagrams.net" type="device" pages="2">
  <diagram id="nexus-v5-power" name="01 - Nguồn từng dây">
    <mxGraphModel dx="1800" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="NeXus — ĐẤU NGUỒN TỪNG DÂY&#xa;Không INA226 · không BNO/BME · chưa lắp còi" style="text;html=1;align=center;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#102A43;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="1600" height="80" as="geometry"/></mxCell>
        <mxCell id="warn" value="RÚT XT60 + RÚT USB · KÊ 3 BÁNH · RELAY CHỌN LOW · THÁO 5V-EN CẢ HAI L298N · E-STOP DÙNG CẶP NC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="2200" height="60" as="geometry"/></mxCell>

        <mxCell id="pTitle" value="DÂY ĐỎ 14AWG — ĐƯỜNG MOTOR" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#102A43;" vertex="1" parent="1"><mxGeometry x="100" y="200" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="battp" value="LiPo XT60 +" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6e6;strokeColor=#d33;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="260" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="fuse" value="Đế + cầu chì 4A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="260" width="220" height="80" as="geometry"/></mxCell>
