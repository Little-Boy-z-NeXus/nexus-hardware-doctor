        <mxCell id="drv2vs" value="L298N #2&#xa;VS / +12V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1790" y="320" width="210" height="80" as="geometry"/></mxCell>

        <mxCell id="eP1" value="P01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=5;strokeColor=#d00000;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="1" source="battp" target="fuse"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eP2" value="P02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=5;strokeColor=#d00000;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="1" source="fuse" target="pct12a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eP3" value="P03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=5;strokeColor=#d00000;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="1" source="pct12a" target="com"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eP7" value="tiếp điểm nội bộ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#64748b;dashed=1;endArrow=none;fontSize=14;" edge="1" parent="1" source="com" target="no"><mxGeometry relative="1" as="geometry"/></mxCell>
