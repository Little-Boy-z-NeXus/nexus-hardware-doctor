        <mxCell id="eP9a" value="P08" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=5;strokeColor=#d00000;endArrow=block;endFill=1;fontSize=14;" edge="1" parent="1" source="pctMotor" target="drv1vs"><mxGeometry relative="1" as="geometry"/></mxCell>
