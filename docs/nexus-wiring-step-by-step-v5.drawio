        <mxCell id="auxTitle" value="NHÁNH +12V SAU CẦU CHÌ" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#102A43;" vertex="1" parent="1"><mxGeometry x="100" y="430" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="pct12b" value="PCT +12V-B&#xa;cổng 1 nhận từ PCT-A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0ffff;strokeColor=#00a8a8;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="490" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="relaydc" value="Relay DC+ / VCC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="460" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="buckin" value="Buck IN+" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="560" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="auxIn" value="P04" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#d00000;endArrow=block;endFill=1;" edge="1" parent="1" source="pct12a" target="pct12b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="auxR" value="P05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#d00000;endArrow=block;endFill=1;" edge="1" parent="1" source="pct12b" target="relaydc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="auxB" value="P06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#d00000;endArrow=block;endFill=1;" edge="1" parent="1" source="pct12b" target="buckin"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="gTitle" value="GND CHUNG — DÂY ĐEN 14AWG" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#102A43;" vertex="1" parent="1"><mxGeometry x="100" y="690" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="battm" value="LiPo XT60 −" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="750" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="ga" value="PCT GND-A&#xa;pin− · L298 #1 · cầu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="750" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="gb" value="PCT GND-B&#xa;L298 #2 · cầu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="750" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="gc" value="PCT GND-C&#xa;buck IN− · relay DC−" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="750" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="eg1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=5;strokeColor=#000;endArrow=block;endFill=1;" edge="1" parent="1" source="battm" target="ga"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eg2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=5;strokeColor=#000;endArrow=block;endFill=1;" edge="1" parent="1" source="ga" target="gb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eg3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=5;strokeColor=#000;endArrow=block;endFill=1;" edge="1" parent="1" source="gb" target="gc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gNote" value="Các PCT chỉ là điểm chia. Tất cả GND phải thông nhau: pin, buck, relay, hai L298N, ESP32, encoder và PS2." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1460" y="750" width="760" height="80" as="geometry"/></mxCell>

        <mxCell id="cTitle" value="CHUỖI ARM / E-STOP — KHÔNG MANG DÒNG MOTOR" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#102A43;" vertex="1" parent="1"><mxGeometry x="100" y="890" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="rin" value="Relay IN&#xa;jumper LOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="950" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="sw1" value="SW1 MOTOR ARM&#xa;2 chân ON/OFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="950" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="estop" value="E-STOP&#xa;đúng cặp NC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="950" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="cgnd" value="GND chung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1160" y="950" width="210" height="80" as="geometry"/></mxCell>
        <mxCell id="ec1" value="C01" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#f07000;endArrow=block;endFill=1;" edge="1" parent="1" source="rin" target="sw1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec2" value="C02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#f07000;endArrow=block;endFill=1;" edge="1" parent="1" source="sw1" target="estop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ec3" value="C03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#f07000;endArrow=block;endFill=1;" edge="1" parent="1" source="estop" target="cgnd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="cNote" value="SW1 ON + E-STOP nhả → relay đóng COM–NO.&#xa;SW1 OFF hoặc nhấn E-STOP → relay nhả, motor mất 12V.&#xa;KHÔNG đưa +12V vào chân IN." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1460" y="930" width="760" height="120" as="geometry"/></mxCell>

        <mxCell id="lTitle" value="5V LOGIC TỪ BUCK" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#102A43;" vertex="1" parent="1"><mxGeometry x="100" y="1100" width="500" height="40" as="geometry"/></mxCell>
        <mxCell id="usb1" value="Buck USB #1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="1170" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="esp" value="ESP32 USB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="1170" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="usb2" value="Buck USB #2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="1290" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="cut" value="Cáp USB-A cắt&#xa;đỏ=5V · đen=GND&#xa;bọc trắng/xanh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="1"><mxGeometry x="450" y="1275" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="split5" value="Chia 5V logic&#xa;→ L298N #1 chân 5V&#xa;→ L298N #2 chân 5V&#xa;đã tháo cả 2 jumper 5V-EN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="850" y="1265" width="360" height="130" as="geometry"/></mxCell>
        <mxCell id="el1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#1b78e2;endArrow=block;endFill=1;" edge="1" parent="1" source="usb1" target="esp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="el2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#1b78e2;endArrow=block;endFill=1;" edge="1" parent="1" source="usb2" target="cut"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="el3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=4;strokeColor=#1b78e2;endArrow=block;endFill=1;" edge="1" parent="1" source="cut" target="split5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="footer" value="ĐO TRƯỚC KHI CẮM: buck USB ≈ 5,0V; MOTOR+ = 0V khi relay OFF và ≈ điện áp pin khi relay ON." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=#102a43;fontColor=#ffffff;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1350" y="1170" width="870" height="170" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="nexus-v5-signals" name="02 - Motor, encoder, PS2">
    <mxGraphModel dx="1800" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="s0"/>
        <mxCell id="s1" parent="s0"/>
        <mxCell id="sTitle" value="NeXus — MOTOR, ENCODER VÀ PS2&#xa;Thứ tự motor: đỏ · đen · vàng · xanh lá · xanh dương · trắng" style="text;html=1;align=center;verticalAlign=middle;fontSize=29;fontStyle=1;fontColor=#102A43;" vertex="1" parent="s1"><mxGeometry x="350" y="20" width="1700" height="90" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;M1 — bánh trước&lt;/b&gt;&lt;br&gt;L298N #1 kênh A&lt;br&gt;&lt;br&gt;Đỏ M+ → OUT1&lt;br&gt;Đen GND encoder → GND&lt;br&gt;Vàng A → GPIO16&lt;br&gt;Xanh lá B → GPIO17&lt;br&gt;Xanh dương VCC → 3V3&lt;br&gt;Trắng M− → OUT2&lt;br&gt;&lt;br&gt;100nF giữa đỏ và trắng" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=20;verticalAlign=top;spacingTop=18;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;" vertex="1" parent="s1"><mxGeometry x="80" y="150" width="690" height="390" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;M2 — bánh sau trái&lt;/b&gt;&lt;br&gt;L298N #1 kênh B&lt;br&gt;&lt;br&gt;Đỏ M+ → OUT3&lt;br&gt;Đen GND encoder → GND&lt;br&gt;Vàng A → GPIO4&lt;br&gt;Xanh lá B → GPIO5&lt;br&gt;Xanh dương VCC → 3V3&lt;br&gt;Trắng M− → OUT4&lt;br&gt;&lt;br&gt;100nF giữa đỏ và trắng" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=20;verticalAlign=top;spacingTop=18;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;" vertex="1" parent="s1"><mxGeometry x="850" y="150" width="690" height="390" as="geometry"/></mxCell>
        <mxCell id="m3" value="&lt;b&gt;M3 — bánh sau phải&lt;/b&gt;&lt;br&gt;L298N #2 kênh A&lt;br&gt;&lt;br&gt;Đỏ M+ → OUT1&lt;br&gt;Đen GND encoder → GND&lt;br&gt;Vàng A → GPIO9&lt;br&gt;Xanh lá B → GPIO10&lt;br&gt;Xanh dương VCC → 3V3&lt;br&gt;Trắng M− → OUT2&lt;br&gt;&lt;br&gt;100nF giữa đỏ và trắng" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=20;verticalAlign=top;spacingTop=18;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="s1"><mxGeometry x="1620" y="150" width="690" height="390" as="geometry"/></mxCell>
        <mxCell id="driverMap" value="&lt;b&gt;GPIO ĐIỀU KHIỂN L298N&lt;/b&gt;&lt;br&gt;&lt;br&gt;M1: GPIO12→ENA · GPIO13→IN1 · GPIO14→IN2&lt;br&gt;M2: GPIO15→ENB · GPIO18→IN3 · GPIO21→IN4&lt;br&gt;M3: GPIO6→ENA · GPIO7→IN1 · GPIO8→IN2&lt;br&gt;&lt;br&gt;L298N #2 kênh B không dùng; OUT3/OUT4 để trống.&lt;br&gt;Không gắn jumper ENA/ENB tại kênh đang dùng PWM." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=24;verticalAlign=top;spacingTop=20;fillColor=#f5f5f5;strokeColor=#666;fontSize=19;" vertex="1" parent="s1"><mxGeometry x="80" y="600" width="1420" height="280" as="geometry"/></mxCell>
        <mxCell id="ps2" value="&lt;b&gt;RECEIVER PS2 → ESP32&lt;/b&gt;&lt;br&gt;&lt;br&gt;VCC đỏ → 3V3&lt;br&gt;GND đen → GND&lt;br&gt;CLK xám → GPIO41&lt;br&gt;ATTN cam → GPIO40&lt;br&gt;CMD xanh lá → GPIO39&lt;br&gt;DATA xanh dương → GPIO38&lt;br&gt;ACK / NC / VIBR → không nối, bọc riêng" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=24;verticalAlign=top;spacingTop=20;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=19;" vertex="1" parent="s1"><mxGeometry x="1580" y="600" width="730" height="360" as="geometry"/></mxCell>
        <mxCell id="caps" value="&lt;b&gt;TỤ LỌC&lt;/b&gt;&lt;br&gt;&lt;br&gt;L298N #1: 1000µF/25V, + vào VS, − có sọc vào GND.&lt;br&gt;L298N #2: 1000µF/25V, + vào VS, − có sọc vào GND.&lt;br&gt;Mỗi motor: 100nF ceramic giữa M+ đỏ và M− trắng." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=24;verticalAlign=top;spacingTop=20;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=19;" vertex="1" parent="s1"><mxGeometry x="80" y="950" width="1420" height="240" as="geometry"/></mxCell>
        <mxCell id="test" value="&lt;b&gt;CẤP ĐIỆN THEO TỪNG NẤC&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Đo không chập +12V/GND.&lt;br&gt;2. Đo buck = 5V.&lt;br&gt;3. Boot ESP32 + kiểm tra PS2.&lt;br&gt;4. Kiểm tra relay và E-STOP khi chưa nối motor.&lt;br&gt;5. Nối từng motor, PWM thấp, bánh kê.&lt;br&gt;6. Chỉ đặt xe xuống khi 3 encoder có xung đúng." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=24;verticalAlign=top;spacingTop=20;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=19;" vertex="1" parent="s1"><mxGeometry x="1580" y="1010" width="730" height="330" as="geometry"/></mxCell>
        <mxCell id="sFooter" value="KHÔNG DÙNG trong cấu hình này: INA226 · BNO055 · BME680 · còi báo pin. UI/firmware phải đánh dấu sensor không khả dụng, không giả số đo 0." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="80" y="1250" width="1420" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
