        <mxCell id="com" value="Relay COM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="950" y="260" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="no" value="Relay NO&#xa;NC bỏ trống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="260" width="190" height="80" as="geometry"/></mxCell>
