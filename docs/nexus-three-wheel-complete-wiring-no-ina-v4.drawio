<mxfile host="app.diagrams.net" modified="2026-10-25T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="nexus-power-v4" name="01-Power-Safety">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;NeXus — NGUỒN, BẢO VỆ VÀ NGẮT MOTOR&lt;/b&gt;&lt;br&gt;LiPo 3S · 2 × L298N · relay 12V 30A · không INA226" style="text;html=1;align=center;verticalAlign=middle;fontSize=30;fontColor=#102a43;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="1900" height="90" as="geometry"/></mxCell>
        <mxCell id="battery" value="&lt;b&gt;LiPo 3S OVONIC&lt;/b&gt;&lt;br&gt;11.1V · 2200mAh&lt;br&gt;12.6V đầy · XT60" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#fb7185;strokeWidth=3;fontSize=18;fontColor=#102a43;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="270" height="150" as="geometry"/></mxCell>
        <mxCell id="fuse" value="&lt;b&gt;F1 + đế cầu chì&lt;/b&gt;&lt;br&gt;4A test kê bánh&lt;br&gt;5A sau khi đo dòng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f59e0b;strokeWidth=3;fontSize=18;fontColor=#102a43;shadow=1;" vertex="1" parent="1"><mxGeometry x="410" y="190" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="split" value="&lt;b&gt;PCT-213 +12V&lt;/b&gt;&lt;br&gt;điểm chia sau F1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#06b6d4;strokeWidth=3;fontSize=18;fontColor=#102a43;shadow=1;" vertex="1" parent="1"><mxGeometry x="750" y="190" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="relay" value="&lt;b&gt;Relay 12V · 30A&lt;/b&gt;&lt;br&gt;COM ← +12V&lt;br&gt;NO → bus motor&lt;br&gt;NC bỏ trống" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=3;fontSize=18;fontColor=#102a43;shadow=1;" vertex="1" parent="1"><mxGeometry x="1090" y="170" width="300" height="190" as="geometry"/></mxCell>
        <mxCell id="motorbus" value="&lt;b&gt;PCT-213 MOTOR&lt;/b&gt;&lt;br&gt;chia hai nhánh VS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#06b6d4;strokeWidth=3;fontSize=18;fontColor=#102a43;shadow=1;" vertex="1" parent="1"><mxGeometry x="1470" y="190" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="l1" value="&lt;b&gt;L298N #1&lt;/b&gt;&lt;br&gt;VS · GND&lt;br&gt;M1 + M2&lt;br&gt;1000µF/25V tại VS-GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#4ade80;strokeWidth=3;fontSize=18;fontColor=#102a43;shadow=1;" vertex="1" parent="1"><mxGeometry x="1810" y="150" width="270" height="180" as="geometry"/></mxCell>
        <mxCell id="l2" value="&lt;b&gt;L298N #2&lt;/b&gt;&lt;br&gt;VS · GND&lt;br&gt;M3 · kênh A&lt;br&gt;1000µF/25V tại VS-GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#4ade80;strokeWidth=3;fontSize=18;fontColor=#102a43;shadow=1;" vertex="1" parent="1"><mxGeometry x="2110" y="150" width="270" height="180" as="geometry"/></mxCell>
        <mxCell id="buck" value="&lt;b&gt;Buck 5V · 3A · 2 USB&lt;/b&gt;&lt;br&gt;IN+ sau F1 · IN− GND&lt;br&gt;USB → ESP32&lt;br&gt;5V → logic 2 × L298N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;strokeWidth=3;fontSize=18;fontColor=#102a43;shadow=1;" vertex="1" parent="1"><mxGeometry x="750" y="500" width="330" height="190" as="geometry"/></mxCell>
        <mxCell id="esp" value="&lt;b&gt;ESP32-S3&lt;/b&gt;&lt;br&gt;nguồn USB 5V&lt;br&gt;vẫn ghi log khi relay OFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#a78bfa;strokeWidth=3;fontSize=18;fontColor=#102a43;shadow=1;" vertex="1" parent="1"><mxGeometry x="1190" y="520" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="relayctl" value="&lt;b&gt;Mạch kích relay · jumper LOW&lt;/b&gt;&lt;br&gt;DC+ → +12V sau F1&lt;br&gt;DC− → GND&lt;br&gt;IN → SW1 ON/OFF → E-STOP NC → GND&lt;br&gt;&lt;font color=&quot;#b42318&quot;&gt;SW1 OFF hoặc nhấn E-STOP = relay nhả&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#94a3b8;strokeWidth=3;fontSize=18;fontColor=#102a43;shadow=1;" vertex="1" parent="1"><mxGeometry x="1600" y="480" width="720" height="230" as="geometry"/></mxCell>
        <mxCell id="alarm" value="&lt;b&gt;Còi báo LiPo 1S–8S&lt;/b&gt;&lt;br&gt;cắm giắc balance 4 chân&lt;br&gt;≈ 3.5V/cell" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fbbf24;strokeWidth=2;fontSize=17;fontColor=#102a43;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="310" height="150" as="geometry"/></mxCell>
        <mxCell id="gnd" value="&lt;b&gt;GND CHUNG 14AWG&lt;/b&gt;&lt;br&gt;pin âm → PCT-213 GND → relay DC−, buck IN−, hai L298N GND; dây 22–24AWG → ESP32/PS2/encoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#111827;strokeWidth=4;fontSize=18;fontColor=#102a43;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="2260" height="130" as="geometry"/></mxCell>
        <mxCell id="safety" value="&lt;b&gt;AN TOÀN&lt;/b&gt;&lt;br&gt;Đường pin/cầu chì/relay/VS/motor: 14AWG, không qua breadboard. Nếu cấp 5V ngoài vào chân logic L298N thì tháo jumper 5V-EN. Kiểm tra đúng cực tụ trước khi cắm XT60." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#fb7185;strokeWidth=3;fontSize=18;fontColor=#9b2c2c;" vertex="1" parent="1"><mxGeometry x="180" y="1060" width="2040" height="150" as="geometry"/></mxCell>
        <mxCell id="e1" value="XT60 · đỏ 14AWG" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=7;fontSize=15;fontColor=#b91c1c;endArrow=block;" edge="1" parent="1" source="battery" target="fuse"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="+12V bảo vệ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=7;fontSize=15;fontColor=#b91c1c;endArrow=block;" edge="1" parent="1" source="fuse" target="split"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="COM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=7;fontSize=15;fontColor=#b91c1c;endArrow=block;" edge="1" parent="1" source="split" target="relay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=7;fontSize=15;fontColor=#b91c1c;endArrow=block;" edge="1" parent="1" source="relay" target="motorbus"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="VS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=7;fontSize=15;fontColor=#b91c1c;endArrow=block;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="motorbus" target="l1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="VS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=7;fontSize=15;fontColor=#b91c1c;endArrow=block;exitX=1;exitY=0.75;entryX=0;entryY=0.75;" edge="1" parent="1" source="motorbus" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="nhánh logic trước relay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=6;fontSize=15;fontColor=#b91c1c;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="split" target="buck"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="USB 5V" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ef4444;strokeWidth=5;fontSize=15;fontColor=#b91c1c;endArrow=block;" edge="1" parent="1" source="buck" target="esp"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nexus-control-v4" name="02-Control-Pins">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root><mxCell id="c0"/><mxCell id="c1" parent="c0"/>
        <mxCell id="ctitle" value="&lt;b&gt;NeXus — BẢNG ĐẤU TÍN HIỆU ESP32-S3&lt;/b&gt;&lt;br&gt;Không INA226 / BNO055 / BME680" style="text;html=1;align=center;verticalAlign=middle;fontSize=30;fontColor=#102a43;" vertex="1" parent="c1"><mxGeometry x="250" y="20" width="1900" height="90" as="geometry"/></mxCell>
        <mxCell id="ps2" value="&lt;b&gt;ĐẦU THU PS2 9 CHÂN · 3.3V&lt;/b&gt;&lt;br&gt;&lt;br&gt;ESP32 3V3　→　VCC đỏ&lt;br&gt;ESP32 GND　→　GND đen&lt;br&gt;GPIO38　→　DATA xanh dương&lt;br&gt;GPIO39　→　CMD xanh lá&lt;br&gt;GPIO40　→　ATTN cam&lt;br&gt;GPIO41　→　CLK xám&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b42318&quot;&gt;ACK · NC · VIBR để trống, bọc riêng&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#a78bfa;strokeWidth=3;fontSize=20;fontColor=#102a43;align=left;spacingLeft=30;verticalAlign=top;spacingTop=25;shadow=1;" vertex="1" parent="c1"><mxGeometry x="80" y="160" width="720" height="500" as="geometry"/></mxCell>
        <mxCell id="drv1" value="&lt;b&gt;L298N #1 · HAI KÊNH&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Motor 1 · kênh A&lt;/b&gt;&lt;br&gt;GPIO12 → ENA (tháo jumper)&lt;br&gt;GPIO13 → IN1&lt;br&gt;GPIO14 → IN2&lt;br&gt;&lt;br&gt;&lt;b&gt;Motor 2 · kênh B&lt;/b&gt;&lt;br&gt;GPIO15 → ENB (tháo jumper)&lt;br&gt;GPIO18 → IN3&lt;br&gt;GPIO21 → IN4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=3;fontSize=20;fontColor=#102a43;align=left;spacingLeft=30;verticalAlign=top;spacingTop=25;shadow=1;" vertex="1" parent="c1"><mxGeometry x="850" y="160" width="720" height="500" as="geometry"/></mxCell>
        <mxCell id="drv2" value="&lt;b&gt;L298N #2 · MOTOR 3&lt;/b&gt;&lt;br&gt;&lt;br&gt;GPIO6 → ENA (tháo jumper)&lt;br&gt;GPIO7 → IN1&lt;br&gt;GPIO8 → IN2&lt;br&gt;&lt;br&gt;&lt;b&gt;Kênh B không dùng&lt;/b&gt;&lt;br&gt;ENB / IN3 / IN4 giữ LOW&lt;br&gt;OUT3 / OUT4 để trống&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b42318&quot;&gt;Không cấp nguồn motor từ ESP32&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#06b6d4;strokeWidth=3;fontSize=20;fontColor=#102a43;align=left;spacingLeft=30;verticalAlign=top;spacingTop=25;shadow=1;" vertex="1" parent="c1"><mxGeometry x="1620" y="160" width="700" height="500" as="geometry"/></mxCell>
        <mxCell id="enc" value="&lt;b&gt;BA ENCODER · VCC 3.3V · GND CHUNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;M1: A vàng → GPIO16 · B xanh lá → GPIO17&lt;br&gt;M2: A vàng → GPIO4　· B xanh lá → GPIO5&lt;br&gt;M3: A vàng → GPIO9　· B xanh lá → GPIO10&lt;br&gt;&lt;br&gt;Cả ba: xanh dương → 3V3 · đen → GND&lt;br&gt;Thứ tự giắc: ĐỎ · ĐEN · VÀNG · XANH LÁ · XANH DƯƠNG · TRẮNG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#4ade80;strokeWidth=3;fontSize=21;fontColor=#102a43;align=left;spacingLeft=35;verticalAlign=top;spacingTop=25;shadow=1;" vertex="1" parent="c1"><mxGeometry x="170" y="760" width="2060" height="330" as="geometry"/></mxCell>
        <mxCell id="logic" value="&lt;b&gt;Nguồn logic&lt;/b&gt;　PS2 + encoder = 3.3V từ ESP32　|　L298N logic = 5V từ buck　|　mọi GND nối chung　|　tín hiệu dùng 22–24AWG và dán nhãn hai đầu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;strokeWidth=3;fontSize=20;fontColor=#102a43;" vertex="1" parent="c1"><mxGeometry x="170" y="1170" width="2060" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nexus-motors-v4" name="03-Motors-Encoders">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root><mxCell id="m0"/><mxCell id="mroot" parent="m0"/>
        <mxCell id="mtitle" value="&lt;b&gt;NeXus — BA MOTOR JGB37-520 / ENCODER&lt;/b&gt;&lt;br&gt;Mỗi motor: 100nF trực tiếp giữa M+ và M−" style="text;html=1;align=center;verticalAlign=middle;fontSize=30;fontColor=#102a43;" vertex="1" parent="mroot"><mxGeometry x="250" y="20" width="1900" height="90" as="geometry"/></mxCell>
        <mxCell id="motor1" value="&lt;b&gt;MOTOR 1 · BÁNH TRÁI&lt;/b&gt;&lt;br&gt;&lt;br&gt;L298N #1A OUT1 → ĐỎ M+&lt;br&gt;L298N #1A OUT2 → TRẮNG M−&lt;br&gt;100nF giữa ĐỎ / TRẮNG&lt;br&gt;&lt;br&gt;XANH DƯƠNG VCC → 3V3&lt;br&gt;ĐEN GND encoder → GND&lt;br&gt;VÀNG A → GPIO16&lt;br&gt;XANH LÁ B → GPIO17" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#ef4444;strokeWidth=4;fontSize=20;fontColor=#102a43;align=left;spacingLeft=30;verticalAlign=top;spacingTop=25;shadow=1;" vertex="1" parent="mroot"><mxGeometry x="70" y="180" width="700" height="520" as="geometry"/></mxCell>
        <mxCell id="motor2" value="&lt;b&gt;MOTOR 2 · BÁNH PHẢI&lt;/b&gt;&lt;br&gt;&lt;br&gt;L298N #1B OUT3 → ĐỎ M+&lt;br&gt;L298N #1B OUT4 → TRẮNG M−&lt;br&gt;100nF giữa ĐỎ / TRẮNG&lt;br&gt;&lt;br&gt;XANH DƯƠNG VCC → 3V3&lt;br&gt;ĐEN GND encoder → GND&lt;br&gt;VÀNG A → GPIO4&lt;br&gt;XANH LÁ B → GPIO5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#2563eb;strokeWidth=4;fontSize=20;fontColor=#102a43;align=left;spacingLeft=30;verticalAlign=top;spacingTop=25;shadow=1;" vertex="1" parent="mroot"><mxGeometry x="850" y="180" width="700" height="520" as="geometry"/></mxCell>
        <mxCell id="motor3" value="&lt;b&gt;MOTOR 3 · BÁNH SAU&lt;/b&gt;&lt;br&gt;&lt;br&gt;L298N #2A OUT1 → ĐỎ M+&lt;br&gt;L298N #2A OUT2 → TRẮNG M−&lt;br&gt;100nF giữa ĐỎ / TRẮNG&lt;br&gt;&lt;br&gt;XANH DƯƠNG VCC → 3V3&lt;br&gt;ĐEN GND encoder → GND&lt;br&gt;VÀNG A → GPIO9&lt;br&gt;XANH LÁ B → GPIO10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#16a34a;strokeWidth=4;fontSize=20;fontColor=#102a43;align=left;spacingLeft=30;verticalAlign=top;spacingTop=25;shadow=1;" vertex="1" parent="mroot"><mxGeometry x="1630" y="180" width="700" height="520" as="geometry"/></mxCell>
        <mxCell id="triangle" value="&lt;b&gt;BỐ TRÍ TAM GIÁC&lt;/b&gt;&lt;br&gt;&lt;br&gt;M1 TRÁI　　　　　　　　M2 PHẢI&lt;br&gt;　　　　　ESP32 + PS2 RX&lt;br&gt;　　　　　　　M3 SAU" style="triangle;whiteSpace=wrap;html=1;direction=north;fillColor=#e0f2fe;strokeColor=#60a5fa;strokeWidth=4;fontSize=21;fontColor=#102a43;verticalAlign=middle;" vertex="1" parent="mroot"><mxGeometry x="120" y="820" width="620" height="420" as="geometry"/></mxCell>
        <mxCell id="parts" value="&lt;b&gt;VẬT TƯ NHỎ&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 14AWG đỏ/đen: nguồn và motor; ferrule/cos đúng cỡ.&lt;br&gt;• 22–24AWG: PWM, DIR, PS2, encoder.&lt;br&gt;• PCT-213: chia +12V/GND; SPL-2: nối nhánh motor.&lt;br&gt;• 2 × 1000µF/25V tại hai L298N; 3 × 100nF tại ba motor.&lt;br&gt;• Gen co nhiệt, dây rút, nhãn M1/M2/M3; tách cáp encoder khỏi dây motor.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b42318&quot;&gt;Không dùng INA226 R100 trong đường nguồn motor. Không có sensor dòng thì UI ghi unavailable, không ghi 0mA giả.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=3;fontSize=20;fontColor=#102a43;align=left;spacingLeft=35;verticalAlign=top;spacingTop=25;shadow=1;" vertex="1" parent="mroot"><mxGeometry x="850" y="800" width="1390" height="460" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
