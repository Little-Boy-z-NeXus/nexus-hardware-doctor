{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexus:device-command:v1:response",
  "title": "NeXus ESP32 serial response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "response_type", "request_id", "command"],
  "properties": {
    "protocol_version": { "const": "1.0.0" },
    "response_type": { "enum": ["ack", "result", "error"] },
    "request_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "command": { "type": ["string", "null"] },
    "accepted": { "type": "boolean" },
    "duplicate": { "type": "boolean" },
    "writes_enabled": { "type": "boolean" },
    "completed_at_ms": { "type": "integer", "minimum": 0 },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "hardware_effect": { "type": "boolean" },
    "result": { "type": "object" },
    "before": { "$ref": "#/$defs/snapshot" },
    "after": { "$ref": "#/$defs/snapshot" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "hardware_effect"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "hardware_effect": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bus_voltage_v",
        "current_ma",
        "power_mw",
        "pwm_percent",
        "driver_enabled"
      ],
      "properties": {
        "bus_voltage_v": { "type": ["number", "null"] },
        "current_ma": { "type": ["number", "null"] },
        "power_mw": { "type": ["number", "null"] },
        "pwm_percent": { "type": "integer", "minimum": 0, "maximum": 80 },
        "driver_enabled": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "response_type": { "const": "ack" } } },
      "then": { "required": ["accepted", "duplicate", "writes_enabled"] }
    },
    {
      "if": { "properties": { "response_type": { "const": "result" } } },
      "then": {
        "required": [
          "completed_at_ms",
          "elapsed_ms",
          "hardware_effect",
          "result",
          "before",
          "after"
        ]
      }
    },
    {
      "if": { "properties": { "response_type": { "const": "error" } } },
      "then": { "required": ["completed_at_ms", "error"] }
    }
  ]
}
